# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Frontend
node_modules
dist
dist-ssr
# Scratch output dir used when `dist/` cannot be emptied (e.g. a locked or
# sandboxed build). Never meant to be committed.
.verify-dist
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
.env
.env.*
!.env.example

# Tauri / Rust
src-tauri/target/

# Local build logs
build-log.txt

# Release signing material — never commit keystores or private signing docs
release.jks
*.jks
*.keystore
keystore.properties
release-keystore-credentials.txt
docs/ANDROID_SIGNING.md
*signing*.md

# Tauri generated files (regenerated by `tauri android init` and build)
src-tauri/gen/
*.apk
*.aab
signed-apk/

# Local binaries — never committed.
# Keep executables out of the repo on principle: they bloat history, and
# third-party tools often carry copyleft or non-commercial licenses that
# should not be redistributed with this MIT project.
bin/
