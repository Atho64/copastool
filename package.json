    "android:init": "tauri android init && node scripts/patch-android-overlay.mjs && tauri icon ./icons-src/icon.png",
    "android:build": "node scripts/patch-android-overlay.mjs && tauri android build --apk"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.5.3",
    "vite": "^8.0.16",
