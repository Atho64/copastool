{
  "name": "copas-tool",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "version:check": "node scripts/check-versions.mjs",
    "tauri": "tauri",
